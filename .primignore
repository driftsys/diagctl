# .primignore — prim's committed escape hatch (gitignore syntax).
# Paths listed here are left byte-for-byte unchanged by prim.
# prim is the driftsys connective-tissue formatter: https://github.com/driftsys/prim

# git-std generates CHANGELOG.md; prim must not reflow generated content.
CHANGELOG.md

# Test fixtures must stay byte-exact.
tests/fixtures/

# Upstream licence text and fonts are carried without reformatting.
LICENSE
assets/

# Generated by cargo-dist; `dist plan` fails when it is reformatted.
.github/workflows/release.yml
